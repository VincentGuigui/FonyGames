{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Deliberately a name that exists nowhere. This top-level block is what a
  // bare `wrangler deploy` (no --env) would use, so an accidental deploy
  // creates a throwaway Worker instead of clobbering dev or prod.
  // Real deploys always pass --env dev | --env prod.
  "name": "fonygames-worker-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Durable Object bindings. `idFromName(roomCode)` routes every player with
  // the same code to the same object — see docs/realtime-server.md.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },

  // IRREVERSIBLE. The Workers Free plan only supports SQLite-backed Durable
  // Objects, and Cloudflare rejects switching the backend on an already
  // deployed class. `new_sqlite_classes` must be right on the first deploy.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  "vars": {
    // Overridden per environment below. Local dev only.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173"
  },

  "observability": { "enabled": true },

  // Two Workers, so a dev round can never land in a production room: separate
  // Workers mean separate Durable Object namespaces.
  // NOTE: `durable_objects` and `vars` are NOT inherited by environments —
  // they must be repeated in every env block or the deployed Worker silently
  // loses the binding. `migrations` and `compatibility_date` are inherited.
  "env": {
    "dev": {
      "name": "fonygames-worker-dev",
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      },
      "vars": {
        // The dev Worker also serves local development, so localhost is
        // allowed here and nowhere else.
        "ALLOWED_ORIGINS": "https://fonygames-dev.guigui.fr,http://localhost:5173,http://127.0.0.1:5173"
      }
    },
    "prod": {
      // Reuses the Worker created in the dashboard, so nothing is orphaned.
      "name": "fonygames-worker",
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://fonygames.guigui.fr"
      }
    }
  }
}
