{
  "name": "fonygames",
  "private": true,
  "type": "module",
  "description": "Silly multiplayer games for the phone already in your pocket",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.118.0"
  }
}
