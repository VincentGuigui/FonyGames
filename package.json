{
  "name": "fonygames",
  "private": true,
  "type": "module",
  "description": "Silly multiplayer games for the phone already in your pocket",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run test:payload && npm run build:api && npm run build:ssr && npm run build:beacon",
    "build:ssr": "node scripts/ssr.mjs",
    "build:beacon": "node scripts/beacon.mjs",
    "build:api": "node scripts/stage-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "npm run test:php && npm run test:flags && npm run test:ready && npm run test:switch && npm run test:ssr-paths && npm run test:game-text && npm run test:game-ui-i18n && npm run test:cardstate && npm run test:outlines && npm run test:og && npm run test:cards && npm run test:over && npm run test:over-ui && npm run test:seo && npm run test:cm && npm run test:drift && npm run test:bomb && npm run test:grid && npm run test:grid-ui && npm run test:squash-ui && npm run test:bump && npm run test:bomb-ui && npm run test:steady && npm run test:steady-ui && npm run test:rush && npm run test:rush-ui && npm run test:hunt && npm run test:hunt-ui && npm run test:sprites && npm run test:router && npm run test:hash && npm run test:squash && npm run test:spill && npm run test:spill-aim && npm run test:siege && npm run test:sling && npm run test:sling-game && npm run test:sling-room && npm run test:solo && npm run test:plays && npm run test:screen && npm run test:scores && npm run test:blast && npm run test:i18n && npm run test:analytics-client && npm run test:neon && npm run test:steer && npm run test:neon-ui && npm run test:taptap && npm run test:taptap-ui && npm run test:taps100 && npm run test:taps100-ui && npm run test:ufohunt && npm run test:ufohunt-ui && npm run test:fighter && npm run test:tttt && npm run test:end-delay && npm run test:admin-stats && npm run test:abduct && npm run test:abduct-ui",
    "test:php": "node scripts/php-test.mjs",
    "test:payload": "node scripts/payload-check.mjs",
    "test:i18n": "esbuild www/src/core/i18n/i18n.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/i18n.test.mjs --log-level=warning && node node_modules/.cache/i18n.test.mjs",
    "test:analytics-client": "esbuild www/src/core/analytics.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/analyticsClient.test.mjs --log-level=warning && node node_modules/.cache/analyticsClient.test.mjs",
    "test:spill-aim": "esbuild shared/spillGeometry.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/spillAim.test.mjs --log-level=warning && node node_modules/.cache/spillAim.test.mjs",
    "test:squash": "esbuild worker/squashMosquitoes.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/squash.test.mjs --log-level=warning && node node_modules/.cache/squash.test.mjs",
    "test:neon": "esbuild worker/neonFall.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/neon.test.mjs --log-level=warning && node node_modules/.cache/neon.test.mjs",
    "test:taptap": "esbuild worker/tapTapMusic.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/taptap.test.mjs --log-level=warning && node node_modules/.cache/taptap.test.mjs",
    "test:taptap-ui": "esbuild www/src/games/tap-tap-music/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/taptapui.test.mjs --log-level=warning && node node_modules/.cache/taptapui.test.mjs",
    "test:taps100": "esbuild worker/taps100.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/taps100.test.mjs --log-level=warning && node node_modules/.cache/taps100.test.mjs",
    "test:taps100-ui": "esbuild www/src/games/hundred-taps/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/taps100ui.test.mjs --log-level=warning && node node_modules/.cache/taps100ui.test.mjs",
    "test:ufohunt": "esbuild worker/ufoHunt.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/ufohunt.test.mjs --log-level=warning && node node_modules/.cache/ufohunt.test.mjs",
    "test:ufohunt-ui": "esbuild www/src/games/ufo-hunt/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/ufohuntui.test.mjs --log-level=warning && node node_modules/.cache/ufohuntui.test.mjs",
    "test:abduct": "esbuild worker/aliensLoveCows.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/abduct.test.mjs --log-level=warning && node node_modules/.cache/abduct.test.mjs",
    "test:abduct-ui": "esbuild www/src/games/aliens-love-cows/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/abductui.test.mjs --log-level=warning && node node_modules/.cache/abductui.test.mjs",
    "test:fighter": "esbuild worker/tapFighter.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/fighter.test.mjs --log-level=warning && node node_modules/.cache/fighter.test.mjs",
    "test:tttt": "esbuild worker/ticTacTicTacToe.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/tttt.test.mjs --log-level=warning && node node_modules/.cache/tttt.test.mjs",
    "test:end-delay": "esbuild www/src/core/room/endDelay.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/endDelay.test.mjs --log-level=warning && node node_modules/.cache/endDelay.test.mjs",
    "test:admin-stats": "esbuild www/src/core/admin/stats.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/adminStats.test.mjs --log-level=warning && node node_modules/.cache/adminStats.test.mjs",
    "test:steer": "esbuild www/src/core/sensors/steer.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/steer.test.mjs --log-level=warning && node node_modules/.cache/steer.test.mjs",
    "test:neon-ui": "esbuild www/src/games/neon-fall/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/neonui.test.mjs --log-level=warning && node node_modules/.cache/neonui.test.mjs",
    "test:spill": "esbuild worker/spill.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/spill.test.mjs --log-level=warning && node node_modules/.cache/spill.test.mjs",
    "test:siege": "esbuild worker/goatSiege.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/siege.test.mjs --log-level=warning && node node_modules/.cache/siege.test.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy:dev": "wrangler deploy --env dev",
    "worker:deploy:prod": "wrangler deploy --env prod",
    "worker:delete:prod:dry": "wrangler delete --env prod --dry-run",
    "worker:delete:prod": "wrangler delete --env prod",
    "test:sling": "esbuild www/src/games/sling-puck/physics.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/sling.test.mjs --log-level=warning && node node_modules/.cache/sling.test.mjs",
    "test:sling-game": "esbuild www/src/games/sling-puck/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/slingGame.test.mjs --log-level=warning && node node_modules/.cache/slingGame.test.mjs",
    "test:sling-room": "esbuild worker/slingPuck.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/slingRoom.test.mjs --log-level=warning && node node_modules/.cache/slingRoom.test.mjs",
    "art:outlines": "node www/src/games/outlines.mjs",
    "prebuild": "npm run art:outlines && npm run art:og",
    "test:outlines": "node www/src/games/outlines.mjs --check",
    "test:cards": "node www/src/games/cards.test.mjs",
    "test:over": "node www/src/games/gameover.test.mjs",
    "test:over-ui": "esbuild www/src/core/ui/gameover.test.tsx --bundle --format=esm --platform=node --jsx=automatic --jsx-import-source=preact --external:preact --external:preact-render-to-string --outfile=node_modules/.cache/overui.test.mjs --log-level=warning && node node_modules/.cache/overui.test.mjs",
    "test:sprites": "esbuild www/src/core/art/sprites.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/sprites.test.mjs --log-level=warning && node node_modules/.cache/sprites.test.mjs",
    "test:bump": "esbuild www/src/core/sensors/bump.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/bumpsensor.test.mjs --log-level=warning && node node_modules/.cache/bumpsensor.test.mjs",
    "test:grid": "esbuild worker/gridAttack.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/grid.test.mjs --log-level=warning && node node_modules/.cache/grid.test.mjs",
    "test:squash-ui": "esbuild www/src/games/squash-mosquitoes/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/squashui.test.mjs --log-level=warning && node node_modules/.cache/squashui.test.mjs",
    "test:grid-ui": "esbuild www/src/games/grid-attack/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/gridui.test.mjs --log-level=warning && node node_modules/.cache/gridui.test.mjs",
    "test:bomb": "esbuild worker/passTheBomb.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/bomb.test.mjs --log-level=warning && node node_modules/.cache/bomb.test.mjs",
    "test:cm": "esbuild worker/catMouse.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/cm.test.mjs --log-level=warning && node node_modules/.cache/cm.test.mjs",
    "test:drift": "esbuild www/src/games/tap-duel/drift.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/drift.test.mjs --log-level=warning && node node_modules/.cache/drift.test.mjs",
    "test:router": "esbuild worker/router.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/router.test.mjs --log-level=warning && node node_modules/.cache/router.test.mjs",
    "test:cardstate": "esbuild shared/flags.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/cardstate.test.mjs --log-level=warning && node node_modules/.cache/cardstate.test.mjs",
    "test:flags": "esbuild worker/flags.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/flags.test.mjs --log-level=warning && node node_modules/.cache/flags.test.mjs",
    "test:ready": "esbuild shared/readiness.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/readiness.test.mjs --log-level=warning && node node_modules/.cache/readiness.test.mjs",
    "test:switch": "esbuild shared/players.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/players.test.mjs --log-level=warning && node node_modules/.cache/players.test.mjs",
    "test:ssr-paths": "node scripts/ssr-paths.test.mjs",
    "test:game-text": "esbuild www/src/core/i18n/gameText.test.tsx --bundle --format=esm --platform=node --jsx=automatic --jsx-import-source=preact --external:preact --external:preact-render-to-string --outfile=node_modules/.cache/gameText.test.mjs --log-level=warning && node node_modules/.cache/gameText.test.mjs",
    "test:game-ui-i18n": "node www/src/games/game-ui-i18n.test.mjs",
    "art:og": "node www/src/games/og.mjs",
    "test:og": "node www/src/games/og.mjs --check",
    "test:seo": "node www/seo.test.mjs",
    "test:ssr": "node scripts/php-run.mjs api/tests/ssr_check.php",
    "postbuild": "npm run test:ssr",
    "test:hash": "esbuild www/src/core/room/hash.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/hash.test.mjs --log-level=warning && node node_modules/.cache/hash.test.mjs",
    "test:bomb-ui": "esbuild www/src/games/pass-the-bomb/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/bombui.test.mjs --log-level=warning && node node_modules/.cache/bombui.test.mjs",
    "test:steady": "esbuild worker/steadyHand.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/steady.test.mjs --log-level=warning && node node_modules/.cache/steady.test.mjs",
    "test:steady-ui": "esbuild www/src/games/steady-hand/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/steadyui.test.mjs --log-level=warning && node node_modules/.cache/steadyui.test.mjs",
    "test:rush": "esbuild worker/shakeRush.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/rush.test.mjs --log-level=warning && node node_modules/.cache/rush.test.mjs",
    "test:rush-ui": "esbuild www/src/games/shake-rush/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/rushui.test.mjs --log-level=warning && node node_modules/.cache/rushui.test.mjs",
    "test:hunt": "esbuild worker/ghostHunt.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/hunt.test.mjs --log-level=warning && node node_modules/.cache/hunt.test.mjs",
    "test:blast": "esbuild www/src/games/pass-the-bomb/shockwave.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/blast.test.mjs --log-level=warning && node node_modules/.cache/blast.test.mjs",
    "test:scores": "esbuild www/src/core/ui/scoreboard.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/scores.test.mjs --log-level=warning && node node_modules/.cache/scores.test.mjs",
    "test:plays": "esbuild worker/plays.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/plays.test.mjs --log-level=warning && node node_modules/.cache/plays.test.mjs",
    "test:screen": "esbuild www/src/core/screen.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/screen.test.mjs --log-level=warning --external:preact --external:preact/hooks && node node_modules/.cache/screen.test.mjs",
    "test:solo": "esbuild worker/solo.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/solo.test.mjs --log-level=warning && node node_modules/.cache/solo.test.mjs",
    "test:hunt-ui": "esbuild www/src/games/ghost-hunt/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/huntui.test.mjs --log-level=warning && node node_modules/.cache/huntui.test.mjs"
  },
