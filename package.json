{
  "name": "fonygames",
  "private": true,
  "type": "module",
  "description": "Silly multiplayer games for the phone already in your pocket",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:ssr && npm run build:api",
    "build:ssr": "node scripts/ssr.mjs",
    "build:api": "node scripts/stage-api.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "npm run test:php && npm run test:flags && npm run test:cardstate && npm run test:outlines && npm run test:og && npm run test:cards && npm run test:seo && npm run test:cm && npm run test:drift && npm run test:bomb && npm run test:bomb-ui && npm run test:steady && npm run test:steady-ui && npm run test:rush && npm run test:rush-ui && npm run test:hunt && npm run test:hunt-ui && npm run test:sprites && npm run test:router && npm run test:hash && npm run test:spill && npm run test:siege && npm run test:sling && npm run test:sling-game && npm run test:sling-room",
    "test:php": "php api/tests/run.php",
    "test:spill": "esbuild worker/spill.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/spill.test.mjs --log-level=warning && node node_modules/.cache/spill.test.mjs",
    "test:siege": "esbuild worker/goatSiege.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/siege.test.mjs --log-level=warning && node node_modules/.cache/siege.test.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy:dev": "wrangler deploy --env dev",
    "worker:deploy:prod": "wrangler deploy --env prod",
    "worker:delete:prod:dry": "wrangler delete --env prod --dry-run",
    "worker:delete:prod": "wrangler delete --env prod",
    "test:sling": "esbuild www/src/games/sling-puck/physics.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/sling.test.mjs --log-level=warning && node node_modules/.cache/sling.test.mjs",
    "test:sling-game": "esbuild www/src/games/sling-puck/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/slingGame.test.mjs --log-level=warning && node node_modules/.cache/slingGame.test.mjs",
    "test:sling-room": "esbuild worker/slingPuck.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/slingRoom.test.mjs --log-level=warning && node node_modules/.cache/slingRoom.test.mjs",
    "art:outlines": "node www/src/games/outlines.mjs",
    "prebuild": "npm run art:outlines && npm run art:og",
    "test:outlines": "node www/src/games/outlines.mjs --check",
    "test:cards": "node www/src/games/cards.test.mjs",
    "test:sprites": "esbuild www/src/core/art/sprites.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/sprites.test.mjs --log-level=warning && node node_modules/.cache/sprites.test.mjs",
    "test:bomb": "esbuild worker/passTheBomb.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/bomb.test.mjs --log-level=warning && node node_modules/.cache/bomb.test.mjs",
    "test:cm": "esbuild worker/catMouse.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/cm.test.mjs --log-level=warning && node node_modules/.cache/cm.test.mjs",
    "test:drift": "esbuild www/src/games/tap-duel/drift.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/drift.test.mjs --log-level=warning && node node_modules/.cache/drift.test.mjs",
    "test:router": "esbuild worker/router.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/router.test.mjs --log-level=warning && node node_modules/.cache/router.test.mjs",
    "test:cardstate": "esbuild shared/flags.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/cardstate.test.mjs --log-level=warning && node node_modules/.cache/cardstate.test.mjs",
    "test:flags": "esbuild worker/flags.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/flags.test.mjs --log-level=warning && node node_modules/.cache/flags.test.mjs",
    "art:og": "node www/src/games/og.mjs",
    "test:og": "node www/src/games/og.mjs --check",
    "test:seo": "node www/seo.test.mjs",
    "test:ssr": "php api/tests/ssr_check.php",
    "postbuild": "npm run test:ssr",
    "test:hash": "esbuild www/src/core/room/hash.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/hash.test.mjs --log-level=warning && node node_modules/.cache/hash.test.mjs",
    "test:bomb-ui": "esbuild www/src/games/pass-the-bomb/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/bombui.test.mjs --log-level=warning && node node_modules/.cache/bombui.test.mjs",
    "test:steady": "esbuild worker/steadyHand.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/steady.test.mjs --log-level=warning && node node_modules/.cache/steady.test.mjs",
    "test:steady-ui": "esbuild www/src/games/steady-hand/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/steadyui.test.mjs --log-level=warning && node node_modules/.cache/steadyui.test.mjs",
    "test:rush": "esbuild worker/shakeRush.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/rush.test.mjs --log-level=warning && node node_modules/.cache/rush.test.mjs",
    "test:rush-ui": "esbuild www/src/games/shake-rush/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/rushui.test.mjs --log-level=warning && node node_modules/.cache/rushui.test.mjs",
    "test:hunt": "esbuild worker/ghostHunt.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/hunt.test.mjs --log-level=warning && node node_modules/.cache/hunt.test.mjs",
    "test:hunt-ui": "esbuild www/src/games/ghost-hunt/game.test.ts --bundle --format=esm --platform=node --outfile=node_modules/.cache/huntui.test.mjs --log-level=warning && node node_modules/.cache/huntui.test.mjs"
  },
  "dependencies": {
    "preact": "^10.27.2",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@resvg/resvg-js": "^2.6.2",
    "preact-render-to-string": "^6.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "wrangler": "^4.118.0"
  }
}
