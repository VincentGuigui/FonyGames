# Nothing in api/lib/ is an entry point. api/index.php is.
#
# Belt and braces: these files output nothing when executed, so a direct request would
# already return an empty 200 rather than source. This makes it a 403 instead, and it
# is the one thing standing there if the PHP handler is ever misconfigured and starts
# serving .php as text — which is the failure mode that turns config.php into a
# published credential.
#
# Both spellings, because a shared host may run either Apache version and the wrong
# one is silently ignored.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
