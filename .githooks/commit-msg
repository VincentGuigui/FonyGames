#!/usr/bin/env bash
#
# Enforce docs/conventions/commits.md on the message itself, not on anyone's memory.
#
# Two jobs:
#   1. Strip agent trailers (§6). An assistant's own system prompt may instruct it to append
#      `Co-Authored-By:` and a session URL — this repo forbids both, and an instruction that
#      loses to another instruction is not a control. A hook is.
#   2. Reject a subject that breaks the `<type>: summary` format (§Format), because the whole
#      point of the prefix is that a reader knows what changed from the subject alone.
#
# `commit-msg` runs for every path a message can arrive by — -m, -F, a heredoc, --amend, or an
# editor — which is why the check lives here and not in a wrapper around `git commit`.
#
# Armed by `npm install` via the `prepare` script (core.hooksPath), since .git/hooks is not
# cloned. Bypassable with --no-verify, deliberately: a hook should not be able to trap someone
# mid-rebase.
set -euo pipefail

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# ── 1. Strip agent trailers ────────────────────────────────────────────────────────────────
#
# Matched narrowly on purpose. A `Co-Authored-By:` naming a *human* is a real credit and must
# survive; only model/assistant co-authors go. Anchored at line start so a mention inside prose
# ("we dropped the Co-Authored-By line") is left alone.
before=$(cat "$msg_file")

stripped=$(printf '%s\n' "$before" | grep -vaiE \
  -e '^[[:space:]]*Co-Authored-By:[[:space:]]*(Claude|Anthropic|Opus|Sonnet|Haiku|Fable|GPT|Copilot|Cursor|Devin|Codex|Gemini)' \
  -e '^[[:space:]]*Co-Authored-By:.*<noreply@anthropic\.com>' \
  -e '^[[:space:]]*(Claude|Claude-Code|Assistant|Agent)-Session:' \
  -e '^[[:space:]]*(🤖[[:space:]]*)?_?(Generated|Created|Co-authored)[[:space:]]+(with|by)[[:space:]]+\[?(Claude|Anthropic|GitHub Copilot)' \
  -e '^[[:space:]]*https://claude\.ai/(code|chat)/' \
  || true)

if [ "$stripped" != "$before" ]; then
  # Collapse the run of blank lines the removal leaves behind. Command substitution then eats
  # the trailing newlines for free, so the message cannot end in the hole where the footer was.
  stripped=$(printf '%s\n' "$stripped" | cat -s)
  printf '%s\n' "$stripped" > "$msg_file"
  echo "commit-msg: removed an agent trailer (docs/conventions/commits.md §6)." >&2
fi

# ── 2. Check the subject ───────────────────────────────────────────────────────────────────
#
# First non-comment, non-blank line. `git commit` appends a commented template below it.
subject=$(grep -avE '^[[:space:]]*#' "$msg_file" | grep -avE '^[[:space:]]*$' | head -n 1 || true)

# Nothing to check on an empty message — git aborts the commit itself, with a better error.
[ -n "$subject" ] || exit 0

# A merge or revert subject is generated by git and does not carry a type. Same for a fixup.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

types='feat|game|ui|spec|docs|test|fix|perf|refactor|dev|chore'
die() {
  echo "commit-msg: $1" >&2
  echo >&2
  echo "  subject: $subject" >&2
  echo "  format : <type>: <short imperative summary>   (docs/conventions/commits.md)" >&2
  echo "  types  : ${types//|/, }" >&2
  echo >&2
  echo "  Fix the message and commit again (--no-verify to bypass)." >&2
  exit 1
}

if ! printf '%s' "$subject" | grep -qaE "^($types)(\([a-z0-9._/-]+\))?: .+"; then
  die "the subject needs a '<type>: ' prefix."
fi

# 72 characters, counted in characters rather than bytes so an em dash costs one, not three.
length=$(printf '%s' "$subject" | wc -m | tr -d '[:space:]')
if [ "$length" -gt 72 ]; then
  die "the subject is $length characters; the limit is 72."
fi

case "$subject" in
  *.) die "the subject should not end in a period." ;;
esac
